# Copy this file to `.env` (which is gitignored) and fill in your keys.
# The scripts read these via os.environ.get(...), with a getpass fallback if
# a variable is unset.

# --- Required for OpenAI (Stages 1, 2, 4 for GPT-4o-mini, GPT-5.4-mini) ---
OPENAI_API_KEY=

# --- Required for Google AI Studio (Stage 3: Gemini 2.5 Flash Lite) ---
GOOGLE_API_KEY=
# GEMINI_API_KEY=          # (either name works)

# --- Required for OpenRouter (Stage 3: Llama 3.3 70B) ---
OPENROUTER_API_KEY=

# --- Supplementary only (not needed for paper reproduction). Set this
#     if you also want to re-run the Claude Haiku cell in supplementary/. ---
# ANTHROPIC_API_KEY=
